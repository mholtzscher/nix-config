input {
    keyboard {
        xkb {
            layout "us"
            model ""
            rules ""
            variant ""
        }
        repeat-delay 600
        repeat-rate 25
        track-layout "global"
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.200000
        accel-profile "adaptive"
    }
    mouse {
        accel-speed 0.200000
        accel-profile "adaptive"
    }
}
output "DP-1" {
    scale 1.000000
    transform "normal"
    position x=0 y=0
    mode "5120x1440@120.000000"
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
layout {
    gaps 10
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    focus-ring { width 0; }
    border { off; }
    background-color "transparent"
    default-column-width { proportion 0.500000; }
    preset-column-widths {
        proportion 0.250000
        proportion 0.500000
        proportion 0.750000
    }
    center-focused-column "always"
}
cursor {
    xcursor-theme "default"
    xcursor-size 24
}
binds {
    Mod+0 { focus-workspace 10; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Alt+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+B { spawn "helium"; }
    Mod+C { center-column; }
    Mod+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+E { spawn "nautilus"; }
    Mod+End { focus-column-last; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { maximize-column; }
    Mod+H { focus-column-left; }
    Mod+Home { focus-column-first; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+M { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Q { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+A { spawn "bash" "-c" "grim - | wl-copy"; }
    Mod+Shift+D { spawn "systemctl" "--user" "restart" "noctalia.service"; }
    Mod+Shift+E { quit; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+I { spawn "capture-display-debug"; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+O { spawn "refresh-displays"; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+S { spawn "bash" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Slash { spawn "pkill" "-USR2" "-x" "handy"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+T { spawn "ghostty"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Y { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
}
spawn-at-startup "solaar" "-w" "hide"
spawn-at-startup "handy --start-hidden"
window-rule {
    match app-id="1password"
    default-column-width { proportion 0.250000; }
}
window-rule {
    match app-id="vesktop"
    default-column-width { proportion 0.250000; }
}
window-rule {
    match app-id="^steam$"
    match title="^Steam$"
    match title="^Friends List$"
    default-column-width { proportion 0.500000; }
}
window-rule {
    match app-id="^steam_app_.*"
    open-fullscreen true
}
window-rule {
    match app-id="^gamescope$"
    open-fullscreen true
}
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
debug {
    honor-xdg-activation-with-invalid-serial
}
animations {
    slowdown 2.500000
    window-close { custom-shader " vec4 pixelate_close(vec3 coords_geo, vec3 size_geo) {\n    // Discard pixels outside window bounds\n    if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) {\n        return vec4(0.0);\n    }\n    float progress = niri_clamped_progress;\n    float border_width = 0.008;\n    vec2 coords = coords_geo.xy;\n    // Check if we're in the border region\n    bool in_border = coords.x < border_width || coords.x > (1.0 - border_width) ||\n                    coords.y < border_width || coords.y > (1.0 - border_width);\n    // Only pixelate the inner content, not the border\n    if (!in_border) {\n        float pixel_size = progress * 0.1;\n        if (pixel_size > 0.0) {\n            coords = floor(coords / pixel_size) * pixel_size + pixel_size * 0.5;\n        }\n        // Clamp sampling to avoid border area\n        coords = clamp(coords, border_width, 1.0 - border_width);\n    }\n    vec3 new_coords = vec3(coords, 1.0);\n    vec3 coords_tex = niri_geo_to_tex * new_coords;\n    vec4 color = texture2D(niri_tex, coords_tex.st);\n    color.a *= (1.0 - progress);\n    return color;\n}\nvec4 close_color(vec3 coords_geo, vec3 size_geo) {\n  return pixelate_close(coords_geo, size_geo);\n}\n"; }
    window-open { custom-shader " vec4 pixelate_open(vec3 coords_geo, vec3 size_geo) {\n    // Discard pixels outside window bounds\n    if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) {\n        return vec4(0.0);\n    }\n    float progress = niri_clamped_progress;\n    float border_width = 0.008; // Adjust based on your border size\n    vec2 coords = coords_geo.xy;\n    // Check if we're in the border region\n    bool in_border = coords.x < border_width || coords.x > (1.0 - border_width) ||\n                    coords.y < border_width || coords.y > (1.0 - border_width);\n    // Only pixelate the inner content, not the border\n    if (!in_border) {\n        float pixel_size = (1.0 - progress) * 0.1;\n        if (pixel_size > 0.0) {\n            coords = floor(coords / pixel_size) * pixel_size + pixel_size * 0.5;\n        }\n        // Clamp sampling to avoid border area\n        coords = clamp(coords, border_width, 1.0 - border_width);\n    }\n    vec3 new_coords = vec3(coords, 1.0);\n    vec3 coords_tex = niri_geo_to_tex * new_coords;\n    vec4 color = texture2D(niri_tex, coords_tex.st);\n    color.a *= progress;\n    return color;\n}\nvec4 open_color(vec3 coords_geo, vec3 size_geo) {\n  return pixelate_open(coords_geo, size_geo);\n}\n"; }
}
